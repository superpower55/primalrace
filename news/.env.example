PROVIDER=ollama

OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=
OLLAMA_MODEL=gemma4:31b-cloud

# Self-hosted Gemma 4 12B on Oracle Cloud (see oracle/README.md):
# OLLAMA_BASE_URL=https://<your-vm-domain>
# OLLAMA_API_KEY=<token printed by oracle/setup.sh>
# OLLAMA_MODEL=gemma4:12b
# OLLAMA_NUM_CTX=32768
# OLLAMA_TIMEOUT=900
# MAX_ARTICLE_CHARS=12000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
